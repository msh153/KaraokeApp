<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KaraokeApp.Views.ClientPage"
             Title="Клієнт" BackgroundColor="#0D0D1A">
    <VerticalStackLayout Padding="24,32" Spacing="16" VerticalOptions="Center">

        <VerticalStackLayout BackgroundColor="#1A1A2E" Padding="16" Spacing="6">
            <Label x:Name="LblHostStatus" Text="🔴 Хост не знайдений"
                   FontSize="15" TextColor="#CCCCDD" HorizontalOptions="Center"/>
            <Label x:Name="LblStatus" Text="Натисніть Знайти для підключення"
                   FontSize="13" TextColor="#666688"
                   HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
        </VerticalStackLayout>

        <Button x:Name="BtnMic" Text="🎤"
                BackgroundColor="#1E1E3A" TextColor="White"
                CornerRadius="90" WidthRequest="180" HeightRequest="180"
                FontSize="64" HorizontalOptions="Center"
                Clicked="OnMicToggleClicked"/>

        <Label x:Name="LblMicState" Text="МІК НЕАКТИВНИЙ"
               FontSize="16" FontAttributes="Bold"
               TextColor="#FF5252" HorizontalOptions="Center"/>

        <ProgressBar x:Name="ProgMicLevel" ProgressColor="#A07AFF"
                     BackgroundColor="#1A1A2E" HeightRequest="8" Margin="0,4"/>

        <VerticalStackLayout BackgroundColor="#1A1A2E" Padding="16" Spacing="8">
            <Label Text="Гучність мікрофона" FontSize="14"
                   TextColor="#CCCCDD" HorizontalOptions="Center"/>
            <Slider x:Name="SliderMicVol" Minimum="0" Maximum="1" Value="1"
                    ThumbColor="#A07AFF" MinimumTrackColor="#6C3CE1"
                    MaximumTrackColor="#2D2D50" ValueChanged="OnMicVolumeChanged"/>
        </VerticalStackLayout>

        <VerticalStackLayout x:Name="FrameConnect" BackgroundColor="#1A1A2E"
                             Padding="16" Spacing="10">
            <Label Text="Код сесії хоста (необов'язково):"
                   FontSize="13" TextColor="#666688"/>
            <Entry x:Name="EntryCode" Placeholder="Наприклад: AB12CD34"
                   PlaceholderColor="#444466" TextColor="White"
                   BackgroundColor="#252540" FontSize="16"/>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0" Text="🔍 Знайти"
                        BackgroundColor="#2D2D50" TextColor="#A07AFF"
                        CornerRadius="10" FontSize="13" Clicked="OnFindClicked"/>
                <Button Grid.Column="1" Text="🔗 За кодом"
                        BackgroundColor="#6C3CE1" TextColor="White"
                        CornerRadius="10" FontSize="13"
                        Clicked="OnConnectByCodeClicked"/>
            </Grid>
            <ActivityIndicator x:Name="Spinner" IsRunning="False"
                               Color="#A07AFF" IsVisible="False"/>
        </VerticalStackLayout>

        <Button x:Name="BtnDisconnect" Text="⏹ Відключитись"
                BackgroundColor="#FF3B30" TextColor="White"
                CornerRadius="12" FontSize="15" IsVisible="False"
                Clicked="OnDisconnectClicked"/>

        <Button Text="← Назад" BackgroundColor="Transparent"
                TextColor="#555577" FontSize="14" Clicked="OnBackClicked"/>
    </VerticalStackLayout>
</ContentPage>
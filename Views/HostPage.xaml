<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KaraokeApp.Views.HostPage"
             Title="Хост" BackgroundColor="#0D0D1A"
             xmlns:models="clr-namespace:KaraokeApp.Models">
    <ScrollView>
        <VerticalStackLayout Padding="20,16" Spacing="12">
            
            <!-- Status -->
            <BoxView BackgroundColor="#1A1A2E" CornerRadius="14" HeightRequest="72">
                <BoxView.Behaviors/>
            </BoxView>
            <VerticalStackLayout Margin="16,-80,16,0" Spacing="4">
                <Label x:Name="LblStatus" Text="Готовий" FontSize="14"
                       TextColor="#A07AFF" HorizontalOptions="Center"/>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Label x:Name="LblSpeaker" Grid.Column="0"
                           Text="🔴 JBL не підключений"
                           FontSize="12" TextColor="#CCCCDD" HorizontalOptions="Center"/>
                    <Label x:Name="LblClient" Grid.Column="1"
                           Text="🔴 Клієнт відсутній"
                           FontSize="12" TextColor="#CCCCDD" HorizontalOptions="Center"/>
                </Grid>
            </VerticalStackLayout>

            <!-- Bluetooth -->
            <Label Text="🔊 Bluetooth Динамік" FontSize="15" FontAttributes="Bold"
                   TextColor="White" Margin="4,8,4,0"/>
            <Button x:Name="BtnScan" Text="🔄 Перевірити підключення"
                    BackgroundColor="#2D2D50" TextColor="#A07AFF"
                    CornerRadius="10" FontSize="14" Clicked="OnScanClicked"/>
            <Grid x:Name="GridConnectedDevice" IsVisible="False"
                BackgroundColor="#252540" Padding="12,10"
                ColumnDefinitions="Auto,*">
                <Label Grid.Column="0" Text="🔵" FontSize="16" VerticalOptions="Center"/>
                <VerticalStackLayout Grid.Column="1" Margin="8,0" VerticalOptions="Center">
                    <Label x:Name="LblConnectedDeviceName"
                        FontSize="13" TextColor="White" FontAttributes="Bold"/>
                    <Label Text="Підключено" FontSize="11" TextColor="#00E676"/>
                </VerticalStackLayout>
            </Grid>

            <!-- Session -->
            <Label Text="📡 Сесія" FontSize="15" FontAttributes="Bold"
                TextColor="White" Margin="4,8,4,0"/>

            <!-- Перемикач режиму -->
            <Grid ColumnDefinitions="*,Auto" BackgroundColor="#1A1A2E"
                    Padding="12,10">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                    <Label x:Name="LblModeTitle" Text="Соло режим"
                        FontSize="13" FontAttributes="Bold" TextColor="White"/>
                    <Label x:Name="LblModeDesc" Text="Один телефон, без Wi-Fi"
                        FontSize="11" TextColor="#666688"/>
                </VerticalStackLayout>
                <Switch x:Name="SwitchSoloMode" Grid.Column="1"
                    IsToggled="True"
                    OnColor="#6C3CE1" ThumbColor="#A07AFF"
                    Toggled="OnSoloModeToggled"/>
            </Grid>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" 
                BackgroundColor="#1A1A2E" Padding="12,8">
                <Label Grid.Column="0" Text="🎧" FontSize="18" 
                    VerticalOptions="Center"/>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                <Label x:Name="LblAudioOutput" 
                    Text="🔈 Телефонний динамік"
                    FontSize="13" TextColor="White"/>
                <Label x:Name="LblAudioWarning"
                        Text="⚠️ Рекомендовано підключити гарнітуру"
                        FontSize="11" TextColor="#FFB300" IsVisible="True"/>
                </VerticalStackLayout>
            </Grid>
            <VerticalStackLayout x:Name="FrameSessionCode" IsVisible="False"
                     BackgroundColor="#252540" Padding="12,8">
                <Label Text="Код сесії:" FontSize="11" TextColor="#666688"/>
                <Label x:Name="LblSessionCode" FontSize="24" FontAttributes="Bold"
                    TextColor="#A07AFF" CharacterSpacing="4"/>
            </VerticalStackLayout>
            <Button x:Name="BtnSession" Text="▶ Запустити сесію"
                BackgroundColor="#6C3CE1" TextColor="White"
                CornerRadius="10" FontSize="14" Clicked="OnSessionClicked"/>

            <!-- Music -->
            <Label Text="🎵 Музика" FontSize="15" FontAttributes="Bold"
                   TextColor="White" Margin="4,8,4,0"/>
            <Grid ColumnDefinitions="*,Auto">
                <Label x:Name="LblMusicName" Grid.Column="0"
                       Text="Музика не обрана" TextColor="White" FontSize="14"
                       VerticalOptions="Center" LineBreakMode="TailTruncation"/>
                <Button Grid.Column="1" Text="📂 Обрати"
                        BackgroundColor="#2D2D50" TextColor="#A07AFF"
                        CornerRadius="8" FontSize="13" Padding="10,6"
                        Clicked="OnPickMusicClicked"/>
            </Grid>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button x:Name="BtnPlayPause" Grid.Column="0" Text="▶"
                        BackgroundColor="#6C3CE1" TextColor="White"
                        CornerRadius="28" WidthRequest="56" HeightRequest="56"
                        FontSize="22" Clicked="OnPlayPauseClicked"/>
                <Slider x:Name="SliderMusic" Grid.Column="1"
                        Minimum="0" Maximum="1" Value="0.8"
                        ThumbColor="#A07AFF" MinimumTrackColor="#6C3CE1"
                        MaximumTrackColor="#2D2D50" VerticalOptions="Center"
                        ValueChanged="OnMusicVolumeChanged"/>
            </Grid>

            <!-- Mics -->
            <Label Text="🎤 Мікрофони" FontSize="15" FontAttributes="Bold"
                   TextColor="White" Margin="4,8,4,0"/>
            <Label Text="МІК 1 (цей телефон)" FontSize="13" TextColor="#CCCCDD"/>
            <ProgressBar x:Name="ProgMic1" ProgressColor="#00E676"
                         BackgroundColor="#2D2D50" HeightRequest="6"/>
            <Slider x:Name="SliderMic1" Minimum="0" Maximum="1" Value="1"
                    ThumbColor="#00E676" MinimumTrackColor="#00C853"
                    MaximumTrackColor="#2D2D50" ValueChanged="OnMic1VolumeChanged"/>
            <BoxView HeightRequest="1" Color="#2D2D50"/>
            <Label Text="МІК 2 (інший телефон)" FontSize="13" TextColor="#CCCCDD"/>
            <ProgressBar x:Name="ProgMic2" ProgressColor="#FF6B6B"
                         BackgroundColor="#2D2D50" HeightRequest="6"/>
            <Slider x:Name="SliderMic2" Minimum="0" Maximum="1" Value="1"
                    ThumbColor="#FF6B6B" MinimumTrackColor="#FF5252"
                    MaximumTrackColor="#2D2D50" ValueChanged="OnMic2VolumeChanged"/>

            <Button Text="← Назад" BackgroundColor="Transparent"
                    TextColor="#555577" FontSize="14" Clicked="OnBackClicked"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

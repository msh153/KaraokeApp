<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App identity -->
    <key>CFBundleName</key>
    <string>JBL Karaoke</string>
    <key>CFBundleDisplayName</key>
    <string>JBL Karaoke</string>
    <key>CFBundleIdentifier</key>
    <string>com.karaokeapp.jbl</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <!-- Minimum iOS version -->
    <key>MinimumOSVersion</key>
    <string>14.0</string>

    <!-- ── Permission usage descriptions ───────────────────────────── -->
    <key>NSMicrophoneUsageDescription</key>
    <string>JBL Karaoke потребує мікрофон для захоплення вашого голосу під час співу.</string>

    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>JBL Karaoke використовує Bluetooth для підключення до динаміка JBL Go 3.</string>

    <key>NSBluetoothPeripheralUsageDescription</key>
    <string>JBL Karaoke підключається до Bluetooth-пристроїв (JBL Go 3).</string>

    <key>NSLocalNetworkUsageDescription</key>
    <string>JBL Karaoke використовує локальну мережу Wi-Fi для передачі аудіо між двома телефонами.</string>

    <!-- Allow media file picker -->
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>

    <!-- Audio background mode -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
        <string>fetch</string>
    </array>

    <!-- Supported orientations -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
    </array>

    <!-- Scene configuration -->
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
        <key>UISceneConfigurations</key>
        <dict/>
    </dict>

    <!-- Prevent ATS issues on local network -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KaraokeApp.App">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Colors -->
            <Color x:Key="BgDeep">#0D0D1A</Color>
            <Color x:Key="BgCard">#1A1A2E</Color>
            <Color x:Key="BgItem">#252540</Color>
            <Color x:Key="Accent">#6C3CE1</Color>
            <Color x:Key="AccentLight">#A07AFF</Color>
            <Color x:Key="TextPrimary">#FFFFFF</Color>
            <Color x:Key="TextSecondary">#CCCCDD</Color>
            <Color x:Key="TextMuted">#666688</Color>
            <Color x:Key="Green">#00E676</Color>
            <Color x:Key="Red">#FF5252</Color>

            <!-- Base styles -->
            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="OpenSansRegular" />
                <Setter Property="TextColor"  Value="{StaticResource TextPrimary}" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="FontFamily"   Value="OpenSansRegular" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>

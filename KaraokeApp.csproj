<Project Sdk="Microsoft.NET.Sdk">

<PropertyGroup>
    <TargetFrameworks>net9.0-android;net9.0-windows10.0.19041.0</TargetFrameworks>
	<RootNamespace>KaraokeApp</RootNamespace>
	<OutputType>Exe</OutputType>
	<UseMaui>true</UseMaui>
	<SingleProject>true</SingleProject>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>

	<ApplicationId>com.karaokeapp.jbl</ApplicationId>
	<ApplicationVersion>1</ApplicationVersion>
	<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>

	<SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>
</PropertyGroup>

<!-- Android-специфічні налаштування — ТІЛЬКИ для Android TFM -->
<PropertyGroup Condition="$(TargetFramework.Contains('-windows'))">
	<WindowsPackageType>None</WindowsPackageType>
	<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
	<SelfContained>true</SelfContained>
</PropertyGroup>
<PropertyGroup>
  <EnableWindowsTargeting>true</EnableWindowsTargeting>
</PropertyGroup>
  <!-- Виключаємо .github, .vs і дублікати з компіляції -->
  <ItemGroup>
    <Compile Remove=".github/**" />
    <Compile Remove=".vs/**" />
    <!-- Дублікат в корені репо — реальний файл у Services/ -->
    <Compile Remove="AudioService.cs" />
  </ItemGroup>

  <!-- Виключаємо default MAUI зображення що не існують -->
  <ItemGroup>
    <MauiImage Remove="Resources\Images\dotnet_bot.png" />
    <MauiImage Remove="Resources/Images/dotnet_bot.png" />
  </ItemGroup>

  <!-- Виключаємо iOS/macOS платформи -->
  <ItemGroup Condition="$(TargetFramework.Contains('-android'))">
    <Compile Remove="Platforms/iOS/**" />
    <Compile Remove="Platforms/MacCatalyst/**" />
    <Compile Remove="Platforms/Windows/**" />
    <Compile Remove="Platforms/Tizen/**" />
    <BundleResource Remove="Platforms/iOS/**" />
    <BundleResource Remove="Platforms/MacCatalyst/**" />
  </ItemGroup>

  <!-- Ресурси додатку -->
  <ItemGroup>
    <MauiIcon Include="Resources/AppIcon/appicon.png" ForegroundFile="Resources/AppIcon/appiconfg.png" Color="#6C3CE1" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#0D0D1A" BaseSize="128,128" />
    <MauiFont Include="Resources/Fonts/OpenSans-Regular.ttf" />
    <MauiFont Include="Resources/Fonts/OpenSans-Semibold.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="9.0.10" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="9.0.10" />
    <PackageReference Include="Plugin.BLE" Version="3.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="CommunityToolkit.Maui" Version="9.0.3" />
  </ItemGroup>

  <ItemGroup>
    <MauiXaml Update="App.xaml" Generator="MSBuild:Compile" />
    <MauiXaml Update="Views/MainPage.xaml" Generator="MSBuild:Compile" />
    <MauiXaml Update="Views/HostPage.xaml" Generator="MSBuild:Compile" />
    <MauiXaml Update="Views/ClientPage.xaml" Generator="MSBuild:Compile" />
  </ItemGroup>

</Project>
